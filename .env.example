# Security
SECRET_KEY=your-secret-key-here
SITE_PASSWORD=your-site-password-here
# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bkdict_db

# Gemini API Configuration (called through its OpenAI-compatible endpoint)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TEMPERATURE=0.9
# Gemini thinking effort: low is much faster (about 2s per translation). Leave empty for the model default.
GEMINI_REASONING_EFFORT=low

# Monitoring (optional). Each tool stays off until its keys are set.
# Always off when SKIP_DB=true (tests), even if keys are set here.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=local   (on Vercel this defaults to VERCEL_ENV)
# SENTRY_TRACES_SAMPLE_RATE=1.0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Your Langfuse region: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
LANGFUSE_BASE_URL=
